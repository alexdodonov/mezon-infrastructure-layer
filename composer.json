{
	"name": "mezon/infrastructure-layer",
	"description": "Infrastructure layer",
	"license": "MIT",
	"authors": [
		{
			"name": "Dodonov Alexey",
			"email": "alexey@dodonov.pro",
			"homepage": "http://gdzone.ru",
			"role": "Founder"
		}
	],
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"vimeo/psalm": "^5.22",
		"infection/infection": "^0.27|^0.28",
		"rregeer/phpunit-coverage-check": "0.3.1"
	},
	"require": {
		"php": ">=8.2.0",
		"mezon/conf": "1.2.*"
	},
	"support": {
		"email": "alexey@dodonov.pro",
		"issues": "https://github.com/alexdodonov/mezon-infrastructure-layer/issues",
		"source": "https://github.com/alexdodonov/mezon-infrastructure-layer"
	},
	"minimum-stability": "dev",
	"homepage": "https://github.com/alexdodonov/mezon-infrastructure-layer",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Mezon\\": "./Mezon/"
		}
	},
	"scripts": {
		"test-self": [
			"php ./vendor/phpunit/phpunit/phpunit --configuration=phpunit-self.xml --order-by=random",
			"php ./vendor/rregeer/phpunit-coverage-check/bin/coverage-check ./Tmp//self/coverage.xml 100"
		],
		"psalm-self": "php ./vendor/vimeo/psalm/psalm --show-info=true --no-cache --config=psalm-self.xml",
		"infection-self": "php ./vendor/infection/infection/bin/infection --threads=4 --min-msi=100 --test-framework-options=\"--testsuite=self\""
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		}
	}
}